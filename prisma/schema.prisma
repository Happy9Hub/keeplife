generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  admin
  member
}

enum CategoryKind {
  fixed
  variable
  leisure
}

enum RecordType {
  expense
  bill
  subscription
  maintenance
}

model Household {
  id         String     @id @default(uuid())
  name       String
  createdAt  DateTime   @default(now())
  users      User[]
  categories Category[]
  reminders  Reminder[]

  @@map("households")
}

model User {
  id            String     @id @default(uuid())
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  role          String     @default("member")
  householdId   String?
  passwordHash  String?
  household     Household? @relation(fields: [householdId], references: [id])
  records       Record[]
  reminders     Reminder[]
  accounts      Account[]
  sessions      Session[]

  @@index([householdId])
  @@map("users")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Category {
  id          String       @id @default(uuid())
  nameEn      String
  nameTh      String
  kind        CategoryKind
  householdId String
  household   Household    @relation(fields: [householdId], references: [id])
  records     Record[]

  @@index([householdId])
  @@map("categories")
}

model Record {
  id            String     @id @default(uuid())
  amount        Float
  recordDate    DateTime
  title         String
  type          RecordType
  slipUrl       String?
  bankReference String?    @unique
  isAutoParsed  Boolean    @default(false)
  userId        String
  categoryId    String
  user          User       @relation(fields: [userId], references: [id])
  category      Category   @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([categoryId])
  @@map("records")
}

enum ReminderType {
  maintenance
  passport
  bill
  subscription
}

enum ReminderStatus {
  pending
  completed
  dismissed
}

model Reminder {
  id             String         @id @default(uuid())
  title          String
  type           ReminderType
  dueDate        DateTime
  status         ReminderStatus @default(pending)
  isRecurring    Boolean        @default(false)
  intervalMonths Int?
  userId         String
  householdId    String
  user           User           @relation(fields: [userId], references: [id])
  household      Household      @relation(fields: [householdId], references: [id])

  @@index([dueDate])
  @@index([householdId])
  @@index([userId])
  @@map("reminders")
}
