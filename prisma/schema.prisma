generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  admin
  member
}

enum CategoryKind {
  fixed
  variable
  leisure
}

enum RecordType {
  expense
  bill
  subscription
  maintenance
}

model Household {
  id         String     @id @default(uuid())
  name       String
  createdAt  DateTime   @default(now())
  users      User[]
  categories Category[]
  reminders  Reminder[]

  @@map("households")
}

model User {
  id            String     @id @default(uuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole   @default(member)
  householdId   String?
  household     Household? @relation(fields: [householdId], references: [id])
  records       Record[]
  reminders     Reminder[]
  accounts      Account[]
  sessions      Session[]

  @@index([householdId])
  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([token])
  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Category {
  id          String       @id @default(uuid())
  nameEn      String
  nameTh      String
  kind        CategoryKind
  householdId String
  household   Household    @relation(fields: [householdId], references: [id])
  records     Record[]

  @@index([householdId])
  @@map("categories")
}

model Record {
  id            String     @id @default(uuid())
  amount        Float
  recordDate    DateTime
  title         String
  type          RecordType
  slipUrl       String?
  bankReference String?    @unique
  isAutoParsed  Boolean    @default(false)
  userId        String
  categoryId    String
  user          User       @relation(fields: [userId], references: [id])
  category      Category   @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([categoryId])
  @@map("records")
}

enum ReminderType {
  maintenance
  passport
  bill
  subscription
}

enum ReminderStatus {
  pending
  completed
  dismissed
}

model Reminder {
  id             String         @id @default(uuid())
  title          String
  type           ReminderType
  dueDate        DateTime
  status         ReminderStatus @default(pending)
  isRecurring    Boolean        @default(false)
  intervalMonths Int?
  userId         String
  householdId    String
  user           User           @relation(fields: [userId], references: [id])
  household      Household      @relation(fields: [householdId], references: [id])

  @@index([dueDate])
  @@index([householdId])
  @@index([userId])
  @@map("reminders")
}
