generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum CategoryKind {
  fixed
  variable
  leisure
}

enum RecordType {
  expense
  bill
  subscription
  maintenance
}

// Differentiates personal spend from shared household spend on a Record.
enum ExpenseScope {
  PRIVATE
  SHARED
}

// A user's role *within a specific household* (lives on HouseholdMember,
// not on User, now that a user can belong to many households).
enum HouseholdRole {
  ADMIN
  MEMBER
}

model Household {
  id             String            @id @default(uuid())
  name           String
  createdAt      DateTime          @default(now())
  members        HouseholdMember[]
  activeForUsers User[]            @relation("UserActiveHousehold")
  categories     Category[]
  paymentSources PaymentSource[]
  records        Record[]
  subscriptions  Subscription[]
  documents      Document[]
  reminders      Reminder[]

  @@map("households")
}

model User {
  id                String            @id @default(uuid())
  name              String
  email             String            @unique
  emailVerified     Boolean           @default(false)
  image             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  passwordHash      String?
  // Pointer to the household currently in context for this user (multi-household
  // UX). Not the membership itself — that lives in HouseholdMember.
  activeHouseholdId String?
  activeHousehold   Household?        @relation("UserActiveHousehold", fields: [activeHouseholdId], references: [id], onDelete: SetNull)
  memberships       HouseholdMember[]
  records           Record[]
  subscriptions     Subscription[]
  documents         Document[]
  reminders         Reminder[]
  accounts          Account[]
  sessions          Session[]

  @@index([activeHouseholdId])
  @@map("users")
}

// Junction model for the many-to-many User <-> Household relation.
// One row per (user, household) pair, carrying that user's role in it.
model HouseholdMember {
  id          String        @id @default(uuid())
  userId      String
  householdId String
  role        HouseholdRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
  @@index([userId])
  @@index([householdId])
  @@map("household_members")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Category {
  id          String       @id @default(uuid())
  nameEn      String
  nameTh      String
  kind        CategoryKind
  householdId String
  household   Household    @relation(fields: [householdId], references: [id])
  records     Record[]

  @@index([householdId])
  @@map("categories")
}

// Household-owned funding sources for records (Cash, a card, a wallet...).
// Single free-text name — payment methods are proper nouns, not translated.
model PaymentSource {
  id          String    @id @default(uuid())
  name        String
  householdId String
  createdAt   DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id])
  records     Record[]

  @@index([householdId])
  @@map("payment_sources")
}

model Record {
  id              String        @id @default(uuid())
  amount          Decimal       @db.Decimal(12, 2)
  recordDate      DateTime
  title           String
  type            RecordType
  scope           ExpenseScope  @default(PRIVATE)
  slipUrl         String?
  bankReference   String?       @unique
  isAutoParsed    Boolean       @default(false)
  userId          String
  householdId     String
  categoryId      String
  paymentSourceId String
  user            User          @relation(fields: [userId], references: [id])
  household       Household     @relation(fields: [householdId], references: [id])
  category        Category      @relation(fields: [categoryId], references: [id])
  paymentSource   PaymentSource @relation(fields: [paymentSourceId], references: [id])
  reminders       Reminder[]

  @@index([userId])
  @@index([householdId])
  @@index([categoryId])
  @@index([paymentSourceId])
  @@map("records")
}

enum ReminderType {
  maintenance
  passport
  bill
  subscription
}

enum ReminderStatus {
  pending
  completed
  dismissed
}

model Reminder {
  id             String         @id @default(uuid())
  title          String
  type           ReminderType
  dueDate        DateTime
  status         ReminderStatus @default(pending)
  isRecurring    Boolean        @default(false)
  intervalMonths Int?
  userId         String
  householdId    String
  documentId     String?
  recordId       String?
  user           User           @relation(fields: [userId], references: [id])
  household      Household      @relation(fields: [householdId], references: [id])
  document       Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  record         Record?        @relation(fields: [recordId], references: [id], onDelete: SetNull)

  @@index([dueDate])
  @@index([householdId])
  @@index([userId])
  @@index([documentId])
  @@index([recordId])
  @@map("reminders")
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

// A recurring paid service with its own lifecycle. Distinct from a Record —
// the system will spawn a Record (type `subscription`) each time this cycles.
model Subscription {
  id              String             @id @default(uuid())
  title           String
  amount          Decimal            @db.Decimal(12, 2)
  billingCycle    BillingCycle
  nextBillingDate DateTime
  status          SubscriptionStatus @default(ACTIVE)
  userId          String
  householdId     String
  user            User               @relation(fields: [userId], references: [id])
  household       Household          @relation(fields: [householdId], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId])
  @@index([householdId])
  @@index([nextBillingDate])
  @@map("subscriptions")
}

enum DocumentType {
  PASSPORT
  CONTRACT
  INSURANCE
}

// Metadata + file reference for a physical/scanned document (passports,
// contracts, insurance...). A Reminder can link to one for its expiry.
model Document {
  id           String       @id @default(uuid())
  title        String
  documentType DocumentType
  expiryDate   DateTime?
  fileUrl      String?
  userId       String
  householdId  String
  user         User         @relation(fields: [userId], references: [id])
  household    Household    @relation(fields: [householdId], references: [id])
  reminders    Reminder[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId])
  @@index([householdId])
  @@index([expiryDate])
  @@map("documents")
}
